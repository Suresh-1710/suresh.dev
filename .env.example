# EmailJS credentials — sign up free at https://www.emailjs.com/
# Copy this file to .env, fill in your real values, and the contact form
# will send email directly. Without these set, the form falls back to
# opening a mailto: link instead.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
